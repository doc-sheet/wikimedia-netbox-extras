    {
      "key": {
        "uuid": "ebda4c35_69c2d79b",
        "filename": "customscripts/capirca.py",
        "patchSetId": 5
      },
      "lineNbr": 41,
      "author": {
        "id": 3215
      },
      "writtenOn": "2021-03-22T20:47:00Z",
      "side": 1,
      "message": "Ack. Yes you could drop the .wmnet and .wikimedia.org, but:\n- are we sure the resulting groups are unique (basically do we have any foo.$dc.wmnet and foo.wikimedia.org that will clash the name if removed the suffixes?)\n- the DNS ensures uniqueness\n- if we need to match those with stuff coming from netbox/puppet it might be confusing\n\nI think I\u0027d keep the FQDN for now.",
      "parentUuid": "40bdf887_092330d9",
      "revId": "550daf380872318fd8442b396a30c7e0998d2f08",
      "serverId": "e9e9afe9-4712-486d-8885-f54b72dd1951",
      "unresolved": true
    },
