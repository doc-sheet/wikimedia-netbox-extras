[access]
	inheritFrom = operations/software
[access "refs/*"]
	owner = group ldap/ops
[access "refs/tags/*"]
	create = group ldap/ops
	createTag = group ldap/ops
	createSignedTag = group ldap/ops
	push = group ldap/ops
[project]
	description = Extra components for Wikimedia's Netbox installation.
[submit]
	action = rebase if necessary
